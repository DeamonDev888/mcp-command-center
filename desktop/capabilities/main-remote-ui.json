{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-remote-ui",
  "description": "Contrôles de fenêtre pour l'UI servie par le moteur embarqué (origine http locale, ports 5090-5099 uniquement — plus de wildcard tous ports) : drag de la barre de titre sans décorations + réduire/agrandir/fermer.",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:5090",
      "http://127.0.0.1:5091",
      "http://127.0.0.1:5092",
      "http://127.0.0.1:5093",
      "http://127.0.0.1:5094",
      "http://127.0.0.1:5095",
      "http://127.0.0.1:5096",
      "http://127.0.0.1:5097",
      "http://127.0.0.1:5098",
      "http://127.0.0.1:5099",
      "http://localhost:5090",
      "http://localhost:5091",
      "http://localhost:5092",
      "http://localhost:5093",
      "http://localhost:5094",
      "http://localhost:5095",
      "http://localhost:5096",
      "http://localhost:5097",
      "http://localhost:5098",
      "http://localhost:5099"
    ]
  },
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close"
  ]
}
